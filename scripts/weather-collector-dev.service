[Unit]
Description=Weather Collector - DEV
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaddams
WorkingDirectory=/home/gaddams/.openclaw-next/workspace/prototypes/weather-engine-source
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/bash -c 'source /home/gaddams/.openclaw-next/workspace/prototypes/weather-engine-source/scripts/load_webhooks.sh'
ExecStart=/home/gaddams/.openclaw-next/workspace/prototypes/weather-engine-source/.venv/bin/python /home/gaddams/.openclaw-next/workspace/prototypes/weather-engine-source/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
